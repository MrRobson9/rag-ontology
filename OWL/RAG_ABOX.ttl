#################################################################
#    Classes
#################################################################

###  
:Chunk rdf:type owl:Class ;
       rdfs:subClassOf gufo:FunctionalComplex ;
       rdfs:comment "Menor unidade/parte resultante da divisão realizada em um córpus de documento(s)."@pt-br ,
                    "Smallest unit/part resulting from the division performed on a document corpus."@en .
                   

###  
:ChunkingConfiguration rdf:type owl:Class ;
                       rdfs:subClassOf gufo:FunctionalComplex ;
                       rdfs:comment "Parâmetros de configuração que regem o processo de divisão/particição do córpus de documento(s)."@pt-br ,
                                    "Configuration parameters that govern the division/partitioning process of the document corpus."@en .

###  
:ChunkingExec rdf:type owl:Class ;
              rdfs:subClassOf gufo:Event ;
              rdfs:comment "Processo de divisão/particição do córpus de documento(s) que gerará o Chunk."@pt-br ,
                           "Process of dividing/partitioning the document corpus that will generate the Chunk."@en .

###  
:Citation rdf:type owl:Class ;
          rdfs:subClassOf gufo:Relator ;
          rdfs:subClassOf gufo:Event ;
          rdfs:comment "Referência/correspondência entre a resposta gerada e a unidade particionada do córpus de documento (chunk)."@pt-br ,
                        "Reference/correspondence between the generated answer and the partitioned unit of the document corpus (chunk)."@en .

###  
:ConfidentialLevel rdf:type owl:Class ;
                   rdfs:subClassOf gufo:Quality ;
                   rdfs:comment "Qualidade intrínseca de um odcumento que define seu grau de restrição ou sigilo."@pt-br ,
                                "Intrinsic quality of a document that defines its degree of restriction or confidentiality."@en .

###  
:Document rdf:type owl:Class ;
          rdfs:subClassOf gufo:FunctionalComplex ;
          rdfs:comment "Coleção estruturada e representativa de registros textuais."@pt-br ,
                        "Structured and representative collection of textual records."@en .

###  
:EmbeddingConfiguration rdf:type owl:Class ;
                        rdfs:subClassOf gufo:FunctionalComplex ;
                        rdfs:comment "Parâmetros de configuração que regem o processo codificação dos chunks em vetores matemáticos (EmbeddingExec)."@pt-br ,
                                "Configuration parameters that govern the encoding process of chunks into mathematical vectors (EmbeddingExec)."@en .

###  
:EmbeddingExec rdf:type owl:Class ;
               rdfs:subClassOf gufo:Event ;
               rdfs:comment "Processo de codificação dos chunks em vetores matemáticos e aramazenamento desses vetores em um banco de dados vetorial (VectorStore)."@pt-br ,
                            "Process of encoding chunks into mathematical vectors and storing these vectors in a vector database (VectorStore)."@en .

###  
:EmbeddingModel rdf:type owl:Class ;
                rdfs:subClassOf gufo:FunctionalComplex ;
                rdfs:comment "Molde/formato/função matemático(a) que irá reger como o a informação original será convertida na sequência de números comprensível pelo sistema."@pt-br ,
                             "Mathematical mold/format/function that will govern how the original information is converted into the sequence of numbers understandable by the system."@en .

###  
:EmbeddingVector rdf:type owl:Class ;
                 rdfs:subClassOf gufo:FunctionalComplex ;
                 rdfs:comment "Vetor de informações codificadas resultante do processo EmbeddingExec."@pt-br ,
                                "Vector of encoded information resulting from the EmbeddingExec process."@en .

###  
:FilterPolicy rdf:type owl:Class ;
              rdfs:subClassOf gufo:FunctionalComplex ;
              rdfs:comment "Políticas ou regras de segurança aplicadas durante a recuperação de dados para restringir ou permitir acesso a certos documentos utilizando níveis de confidencialidade."@pt-br ,
                            "Security policies or rules applied during data retrieval to restrict or allow access to certain documents using confidentiality levels."@en .

###  
:FindingType rdf:type owl:Class ;
             rdfs:subClassOf gufo:FunctionalComplex ;
             rdfs:comment "Categoria ou taxonomia de uma descoberta de validação."@pt-br ,
                          "Category or taxonomy of a validation finding."@en .

###  
:GeneratedAnswer rdf:type owl:Class ;
                 rdfs:subClassOf gufo:FunctionalComplex ;
                 rdfs:comment "Resposta final em linguagem natural produzida pelo modelo de linguagem (LLM) como resultado do processamento da pergunta do usuário combinada ao contexto recuperado."@pt-br ,
                                "Final natural language response produced by the language model (LLM) as a result of processing the user query combined with the retrieved context."@en .

###  
:GenerationConfig rdf:type owl:Class ;
                  rdfs:subClassOf gufo:FunctionalComplex ;
                  rdfs:comment "Parâmetros que controlam o comportamento do LLM durante a geração da resposta."@pt-br ,
                                "Parameters that control the behavior of the LLM during answer generation."@en .

###  
:IndexingRun rdf:type owl:Class ;
             rdfs:subClassOf gufo:Event ;
             rdfs:comment "Evento macro de processamento que engloba a rotina completa de preparação dos documentos, incluindo a divisão (ChunkingExec) e a vetorização (EmbeddingExec)."@pt-br ,
                           "Macro processing event that encompasses the entire document preparation routine, including division (ChunkingExec) and vectorization (EmbeddingExec)."@en .

###  
:LLMCall rdf:type owl:Class ;
         rdfs:subClassOf gufo:Event ;
         rdfs:comment "Evento computacional de invocação e execução de um Grande Modelo de Linguagem (LLM) para processar o Prompt e retornar a GeneratedAnswer."@pt-br ,
                      "Computational event of invoking and executing a Large Language Model (LLM) to process the Prompt and return the GeneratedAnswer."@en .

###  
:ModelRelease rdf:type owl:Class ;
              rdfs:subClassOf gufo:FunctionalComplex ;
              rdfs:comment "Versão específica, consolidada e publicada de um modelo de inteligência artificial. Carrega os pesos matemáticos exatos treinados até aquela data."@pt-br ,
                           "Specific, consolidated, and published version of an artificial intelligence model. It carries the exact mathematical weights trained up to that date."@en .

###  
:Prompt rdf:type owl:Class ;
        rdfs:subClassOf gufo:FunctionalComplex ;
        rdfs:comment "Estrutura textual final de instrução enviada ao LLM, que encapsula a pergunta original do usuário, as regras de geração e o contexto factual recuperado (RetrievedContext)."@pt-br ,
                      "Final textual instruction structure sent to the LLM, which encapsulates the original user query, the generation rules, and the retrieved factual context (RetrievedContext)."@en .

###  
:RerankerConfig rdf:type owl:Class ;
                rdfs:subClassOf gufo:FunctionalComplex ;
                rdfs:comment "Parâmetros de configuração para o processo de re-ranqueamento, definindo como os chunks previamente recuperados serão reordenados ou filtrados."@pt-br ,
                                "Configuration parameters for the re-ranking process, defining how the previously retrieved chunks will be reordered or filtered."@en .

###  
:RerankingExec rdf:type owl:Class ;
               rdfs:subClassOf gufo:Event ;
               rdfs:comment "Processo de reordenação ou refino da lista inicial de chunks recuperados, aplicando um modelo secundário mais custoso para garantir maior precisão antes de formar o contexto final."@pt-br ,
                                "Process of reordering or refining the initial list of retrieved chunks, applying a secondary, more costly model to ensure greater precision before forming the final context."@en .

###  
:RetrievalConfig rdf:type owl:Class ;
                 rdfs:subClassOf gufo:FunctionalComplex ;
                 rdfs:comment "Parâmetros e estratégias que regem a busca vetorial no VectorStore, como a métrica de similaridade matemática e o número de resultados esperados."@pt-br ,
                                "Parameters and strategies that govern the vector search in the VectorStore, such as the mathematical similarity metric and the expected number of results."@en .

###  
:RetrievalExec rdf:type owl:Class ;
               rdfs:subClassOf gufo:Event ;
               rdfs:comment "Processo de busca que compara matematicamente o vetor da query do usuário com os vetores armazenados no VectorStore para extrair os chunks mais relevantes."@pt-br ,
                            "Search process that mathematically compares the user query vector with the vectors stored in the VectorStore to extract the most relevant chunks."@en .

###  
:RetrievedChunk rdf:type owl:Class ;
                rdfs:subClassOf gufo:Relator ;
                rdfs:comment "Papel assumido por um Chunk específico após ser selecionado pelo processo de recuperação devido à sua alta relevância matemática (score/distância) em relação à query."@pt-br ,
                             "Role assumed by a specific Chunk after being selected by the retrieval process due to its high mathematical relevance (score/distance) in relation to the query."@en .

###  
:RetrievedContext rdf:type owl:Class ;
                  rdfs:subClassOf gufo:FunctionalComplex ;
                  rdfs:comment "Agrupamento consolidado dos chunks recuperados que servirá como a base de conhecimento factual fornecida ao LLM para fundamentar a resposta."@pt-br ,
                                "Consolidated grouping of retrieved chunks that will serve as the factual knowledge base provided to the LLM to ground the answer."@en .

###  
:UserQuery rdf:type owl:Class ;
           rdfs:subClassOf gufo:FunctionalComplex ;
           rdfs:comment "Pergunta, instrução ou termo de busca inicial formulado e submetido pelo usuário humano ou sistema cliente."@pt-br ,
                        "Initial question, instruction, or search term formulated and submitted by the human user or client system."@en .

###  
:ValidationExec rdf:type owl:Class ;
                rdfs:subClassOf gufo:Event ;
                rdfs:comment "Processo metodológico ou computacional de avaliar a GeneratedAnswer contra a UserQuery e o RetrievedContext, verificando se há suporte factual ou alucinações (gerando ValidationFindings).."@pt-br ,
                             "Methodological or computational process of evaluating the GeneratedAnswer against the UserQuery and the RetrievedContext, verifying if there is factual support or hallucinations (generating ValidationFindings)."@en .

###  
:ValidationFinding rdf:type owl:Class ;
                   rdfs:subClassOf gufo:FunctionalComplex ;
                   rdfs:comment "Evidência, resultado ou diagnóstico gerado pelo processo de validação, contendo a justificativa e a severidade sobre a qualidade ou precisão da resposta gerada."@pt-br ,
                                "Evidence, result, or diagnosis generated by the validation process, containing the rationale and severity regarding the quality or precision of the generated answer."@en .

###  
:VectorStore rdf:type owl:Class ;
             rdfs:subClassOf gufo:FunctionalComplex ;
             rdfs:comment "Banco de dados otimizado e especializado no armazenamento, indexação e busca eficiente de representações matemáticas de alta dimensionalidade (EmbeddingVectors)."@pt-br ,
                          "Database optimized and specialized in the storage, indexing, and efficient search of high-dimensional mathematical representations (EmbeddingVectors)."@en .

