# --- PATCHES adicionados para compatibilidade com queries CQ1-CQ10 (demo q1) ---

# CQ1: metadados dos chunks
rag:chunk1 rag:chunkId "chunk1" ; rag:endOffset 500 .
rag:chunk2 rag:chunkId "chunk2" ; rag:endOffset 1000 .
rag:chunk3 rag:chunkId "chunk3" ; rag:endOffset 1500 .

# CQ6: completar RetrievalConfig (alguns geradores sintéticos deixam campos opcionais ausentes)
rag:retrievalConf1 rag:retrievalStrategy "dense-vector" ;
                  rag:similarityMetric "cosine" ;
                  rag:filters "confidential=false" .

# CQ7: reranking (ligações e parâmetros)
rag:rerankExec1 a rag:RerankingExec ;
               rag:execId_4 "rerankExec1" .

rag:rerankerConf1 a rag:RerankerConfig ;
                 rag:topK 3 ;
                 rag:filters_1 "none" ;
                 rdfs:label "cross-encoder reranker"@en .

rag:retrievalExec1 rag:partOf rag:rerankExec1 ;
                  rag:uses_2 rag:rerankerConf1 .

# Scores finais de reranking (reuso dos mesmos rc do contexto demo)
rag:rc1 rag:finalRank 1 ; rag:finalScore 0.91 .
rag:rc2 rag:finalRank 2 ; rag:finalScore 0.87 .
rag:rc3 rag:finalRank 3 ; rag:finalScore 0.82 .

# CQ9/CQ10: achados de validação e citações/rastreabilidade
rag:answer1 rag:hasFinding rag:finding1 ;
           rag:cites rag:cit1, rag:cit2 .

rag:ctx1 rag:about rag:finding1 .

rag:finding1 a rag:ValidationFinding ;
           rag:produces_1 rag:valExec1 .

rag:valExec1 a rag:ValidationExec ;
           rag:validates rag:answer1 .

rag:findingTypeUnsupported a rag:FindingType ;
                          rag:hasType rag:finding1 .

rag:cit1 a rag:Citation ;
        rag:refersTo rag:rc1 ;
        rag:span "Trecho evidencial 1" ;
        rag:startOffset 0 ;
        rag:confidence 0.95 .

rag:cit2 a rag:Citation ;
        rag:refersTo rag:rc2 ;
        rag:span "Trecho evidencial 2" ;
        rag:startOffset 120 ;
        rag:confidence 0.89 .

# CQ8: restrição de confidencialidade (um documento/chunk sigiloso para demonstrar consulta)
rag:confLevel1 a rag:ConfidentialLevel ;
             rag:inheresIn rag:doc1 .

# Se seu T-Box/A-box usa a variante 'hasConfidentialLevel', mantemos também:
rag:doc1 rag:hasConfidentialLevel rag:confLevel1 .


