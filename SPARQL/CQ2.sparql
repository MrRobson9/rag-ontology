PREFIX : <http://purl.org/mrrobson9/rag#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT
  ?doc ?docLabel ?chunk ?chunkLabel ?embExec
  ?model ?modelLabel ?release ?releaseLabel
WHERE {
  VALUES ?doc { :doc1 }
  ?doc :hasChunk ?chunk .
  
  # Liga o chunk à execução (No seu A-box é uses_1)
  ?embExec a :EmbeddingExec ;
           (:uses|:uses_1|:uses_2) ?chunk .
           
  # Liga a execução ao modelo de embedding (No seu A-box é uses_2)
  ?embExec (:uses|:uses_1|:uses_2) ?model .
  ?model a :EmbeddingModel .
  
  # Pega o release do modelo
  OPTIONAL { ?model :hasRelease ?release . }
  
  # Labels
  OPTIONAL { ?doc rdfs:label ?docLabel }
  OPTIONAL { ?chunk rdfs:label ?chunkLabel }
  OPTIONAL { ?model rdfs:label ?modelLabel }
  OPTIONAL { ?release rdfs:label ?releaseLabel }
}