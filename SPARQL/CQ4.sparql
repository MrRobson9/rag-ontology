PREFIX : <http://purl.org/mrrobson9/rag#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT
  ?chunk ?chunkLabel
  ?embExec ?embExecLabel
  ?embConf ?embConfLabel
  ?vector ?vectorLabel
WHERE {
  VALUES ?chunk { :chunk1 }
  
  # Acha a execução que processou o chunk
  ?embExec a :EmbeddingExec ;
           (:uses|:uses_1|:uses_2) ?chunk .
           
  # Acha a configuração usada (No A-box está como uses ou uses_5)
  ?embExec (:uses|:uses_5) ?embConf .
  ?embConf a :EmbeddingConfiguration .
  
  # Acha o vetor criado (No A-box está como creates ou creates_1)
  ?embExec (:creates|:creates_1) ?vector .
  ?vector a :EmbeddingVector .

  OPTIONAL { ?chunk rdfs:label ?chunkLabel }
  OPTIONAL { ?embExec rdfs:label ?embExecLabel }
  OPTIONAL { ?embConf rdfs:label ?embConfLabel }
  OPTIONAL { ?vector rdfs:label ?vectorLabel }
}